# Backend environment configuration template.
# Copy to backend/.env (git-ignored) and fill in real local values.
# Never commit backend/.env.

# Must match infra/docker/.env's POSTGRES_USER/PASSWORD/DB/PORT.
DATABASE_URL=postgresql+psycopg2://geostrom:changeme_local_dev@localhost:5434/geostrom

ALLOWED_ORIGINS=["http://localhost:3001","http://localhost:3000"]

# Not used in Phase 3 (no Gemini integration). Present only so the contract
# is visible for a later phase; never read by any Phase 3 code path.
# GEMINI_API_KEY=

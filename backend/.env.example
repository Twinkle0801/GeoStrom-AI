# Backend environment configuration template.
# Copy to backend/.env (git-ignored) and fill in real local values.
# Never commit backend/.env.

# Must match infra/docker/.env's POSTGRES_USER/PASSWORD/DB/PORT.
DATABASE_URL=postgresql+psycopg2://geostrom:changeme_local_dev@localhost:5434/geostrom

ALLOWED_ORIGINS=["http://localhost:3001","http://localhost:3000"]

# Phase 9 -- Gemini explanation layer (app/gemini/). Names only, never a real
# value, in this committed template (docs/API_ARCHITECTURE.md §6.3). Leave
# GEMINI_API_KEY unset/empty to run with no Gemini configured at all -- the
# API then always returns the deterministic fallback explanation; nothing
# fails or crashes.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
